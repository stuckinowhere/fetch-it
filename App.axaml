<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="FetchIt.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="Plex">avares://FetchIt/Assets/Fonts/IBMPlexSans-Medium.ttf#IBM Plex Sans, avares://FetchIt/Assets/Fonts/IBMPlexSans-Regular.ttf#IBM Plex Sans</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">avares://FetchIt/Assets/Fonts/IBMPlexSans-Medium.ttf#IBM Plex Sans</FontFamily>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PaperBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="InkBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="FetchBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="FetchTextBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#FFBDBDBD" />
                    <SolidColorBrush x:Key="MaterialTextBoxBorderColor" Color="#FFFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PaperBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="InkBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="FetchBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="FetchTextBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#FF424242" />
                    <SolidColorBrush x:Key="MaterialTextBoxBorderColor" Color="#FF000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <themes:MaterialTheme BaseTheme="Dark" PrimaryColor="Grey" SecondaryColor="Blue" />
        <icons:MaterialIconStyles />

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource PaperBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource Plex}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Plex}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource Plex}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource InkBrush}" />
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource PaperBrush}" />
            <Setter Property="MinHeight" Value="52" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="{StaticResource Plex}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector="Button.fetch">
            <Setter Property="Background" Value="{DynamicResource FetchBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FetchTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FetchBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="28,0" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="Height" Value="56" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.fetch /template/ Border">
            <Setter Property="Background" Value="{DynamicResource FetchBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.fetch /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FetchBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FetchTextBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.fetch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.88" />
        </Style>
        <Style Selector="Button.Flat">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector="icons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
    </Application.Styles>
</Application>
