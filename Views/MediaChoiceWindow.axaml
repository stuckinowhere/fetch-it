<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="using:FetchIt.Services"
        x:Class="FetchIt.Views.MediaChoiceWindow"
        Icon="/Assets/fetchit.png"
        Title="fetch it"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource PaperBrush}"
        Foreground="{DynamicResource InkBrush}">
    <StackPanel Margin="24" Spacing="16">
        <TextBlock x:Name="Eyebrow"
                   FontSize="12"
                   FontWeight="Bold"
                   Foreground="{DynamicResource MutedBrush}" />
        <TextBlock x:Name="Body"
                   FontSize="16"
                   FontWeight="Medium"
                   TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
            <Button Grid.Column="1"
                    Classes="Flat"
                    Margin="0,0,8,0"
                    Content="{x:Static s:L.Cancel}"
                    IsCancel="True"
                    Click="OnCancelClick" />
            <Button x:Name="PhotosOnly"
                    Grid.Column="2"
                    Classes="Flat"
                    Margin="0,0,8,0"
                    Content="{x:Static s:L.PhotosOnly}"
                    Click="OnPhotosOnlyClick" />
            <Button x:Name="Everything"
                    Grid.Column="3"
                    Classes="fetch"
                    Height="48"
                    MinWidth="120"
                    IsDefault="True"
                    Click="OnEverythingClick">
                <TextBlock Text="{x:Static s:L.PhotosAndVideos}" />
            </Button>
        </Grid>
    </StackPanel>
</Window>
