<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FetchIt.Views.AlertWindow"
        Icon="/Assets/fetchit.png"
        Title=""
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource PaperBrush}"
        Foreground="{DynamicResource InkBrush}">
    <StackPanel Margin="24" Spacing="16">
        <TextBlock x:Name="Eyebrow"
                   FontSize="12"
                   FontWeight="Bold" />
        <TextBlock x:Name="Body"
                   FontSize="16"
                   FontWeight="Medium"
                   TextWrapping="Wrap" />
        <Button Classes="fetch"
                HorizontalAlignment="Right"
                Height="48"
                MinWidth="120"
                Click="OnOkClick">
            <TextBlock Text="OK"
                       FontFamily="{StaticResource Plex}"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{DynamicResource FetchTextBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Button>
    </StackPanel>
</Window>
