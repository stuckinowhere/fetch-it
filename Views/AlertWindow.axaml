<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="using:FetchIt.Services"
        x:Class="FetchIt.Views.AlertWindow"
        Icon="/Assets/fetchit.png"
        Title="fetch it"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource PaperBrush}"
        Foreground="{DynamicResource InkBrush}">
    <StackPanel Margin="24" Spacing="16">
        <TextBlock x:Name="Eyebrow"
                   FontSize="12"
                   FontWeight="Bold" />
        <TextBlock x:Name="Body"
                   FontSize="16"
                   FontWeight="Medium"
                   TextWrapping="Wrap" />
        <Button Classes="fetch"
                HorizontalAlignment="Right"
                Height="48"
                MinWidth="120"
                IsDefault="True"
                IsCancel="True"
                Click="OnOkClick">
            <TextBlock Text="{x:Static s:L.Ok}" />
        </Button>
    </StackPanel>
</Window>
