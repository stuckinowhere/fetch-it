<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FetchIt.ViewModels"
        xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="FetchIt.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/fetchit.png"
        Title=""
        Width="1100"
        Height="700"
        MinWidth="800"
        MinHeight="520"
        CanResize="True"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource PaperBrush}"
        Foreground="{DynamicResource InkBrush}"
        KeyDown="OnKeyDown">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <Border Grid.Row="0" Height="56" Padding="8,0">
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="0"
                        Margin="0,0,4,0">
                    <Button Classes="Flat"
                            Width="48"
                            Height="48"
                            Padding="0"
                            Command="{Binding PickFolderCommand}"
                            ToolTip.Tip="Save folder">
                        <icons:MaterialIcon Kind="Folder"
                                            Width="26"
                                            Height="26" />
                    </Button>
                    <Button Classes="Flat"
                            Width="48"
                            Height="48"
                            Padding="0"
                            Command="{Binding CheckForUpdatesCommand}"
                            ToolTip.Tip="Updates">
                        <icons:MaterialIcon Kind="Update"
                                            Width="26"
                                            Height="26" />
                    </Button>
                    <Button Classes="Flat"
                            Width="48"
                            Height="48"
                            Padding="0"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip.Tip="Theme">
                        <Panel>
                            <icons:MaterialIcon Kind="WeatherNight"
                                                Width="26"
                                                Height="26"
                                                IsVisible="{Binding IsDark}" />
                            <icons:MaterialIcon Kind="WhiteBalanceSunny"
                                                Width="26"
                                                Height="26"
                                                IsVisible="{Binding IsDark, Converter={x:Static BoolConverters.Not}}" />
                        </Panel>
                    </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1"
              RowDefinitions="Auto,Auto,*,Auto"
              Margin="24,12,24,8">
            <Grid ColumnDefinitions="*,Auto">
                <Border BorderBrush="{DynamicResource InkBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Height="56"
                        Padding="14,0"
                        Background="Transparent">
                    <TextBox BorderThickness="0"
                             Background="Transparent"
                             PlaceholderText="https://"
                             Text="{Binding Url}"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding FetchCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                </Border>
                <Button Grid.Column="1"
                        Classes="fetch"
                        Margin="16,0,0,0"
                        Height="56"
                        VerticalAlignment="Stretch"
                        IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}"
                        Command="{Binding FetchCommand}">
                    <TextBlock Text="{Binding FetchLabel}"
                               FontFamily="{StaticResource Plex}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource FetchTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <TextBlock Text="{Binding Error}"
                           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           FontFamily="{StaticResource Plex}"
                           FontSize="14"
                           FontWeight="Medium"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}" />
                <TextBlock Text="{Binding Success}"
                           IsVisible="{Binding Success, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           FontFamily="{StaticResource Plex}"
                           FontSize="14"
                           FontWeight="Medium"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SuccessBrush}" />
            </StackPanel>

            <Grid Grid.Row="2"
                  Margin="0,16,0,0"
                  SizeChanged="OnPreviewSizeChanged">
                <TextBlock Text="Paste a link, then Fetch."
                           IsVisible="{Binding ShowEmptyHint}"
                           FontFamily="{StaticResource Plex}"
                           FontSize="16"
                           FontWeight="Medium"
                           Foreground="{DynamicResource InkBrush}" />
                <TextBlock Text="{Binding ProgressText}"
                           IsVisible="{Binding IsProbing}"
                           FontFamily="{StaticResource Plex}"
                           FontSize="16"
                           FontWeight="Medium"
                           Foreground="{DynamicResource InkBrush}" />

                <Panel IsVisible="{Binding IsSinglePreview}">
                    <Border Background="#1A1A1A" ClipToBounds="True">
                        <Image Source="{Binding Hero.Image}"
                               Stretch="Uniform"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               IsVisible="{Binding Hero.Image, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </Border>
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="12"
                            Background="#CC000000"
                            CornerRadius="4"
                            Padding="8,3">
                        <TextBlock Text="{Binding Hero.Overlay}"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold" />
                    </Border>
                </Panel>

                <ScrollViewer IsVisible="{Binding HasManyPreviews}"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding PreviewCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PreviewCard">
                                    <controls:Card Width="{Binding TileWidth}"
                                                   Margin="0,0,16,16"
                                                   Padding="0">
                                        <StackPanel>
                                            <Panel Height="{Binding TileImageHeight}"
                                                   ClipToBounds="True">
                                                <Border Background="#1A1A1A" />
                                                <Image Source="{Binding Image}"
                                                       Stretch="UniformToFill"
                                                       IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <Border HorizontalAlignment="Left"
                                                        VerticalAlignment="Bottom"
                                                        Margin="8"
                                                        Background="#CC000000"
                                                        CornerRadius="4"
                                                        Padding="6,2">
                                                    <TextBlock Text="{Binding Overlay}"
                                                               Foreground="White"
                                                               FontSize="12"
                                                               FontWeight="Bold" />
                                                </Border>
                                            </Panel>
                                            <TextBlock Text="{Binding Title}"
                                                       Margin="12,8,12,12"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="40"
                                                       FontSize="14"
                                                       FontWeight="Medium" />
                                        </StackPanel>
                                    </controls:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding MoreLabel}"
                                   IsVisible="{Binding HasMore}"
                                   FontFamily="{StaticResource Plex}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Margin="0,0,0,8" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="3"
                  ColumnDefinitions="*,Auto"
                  Margin="0,12,0,0"
                  IsVisible="{Binding HasPreview}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontFamily="{StaticResource Plex}"
                               FontSize="18"
                               FontWeight="Medium"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="48" />
                    <TextBlock Text="{Binding Summary}"
                               Margin="0,4,0,0"
                               FontFamily="{StaticResource Plex}"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="fetch"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        IsEnabled="{Binding CanDownload}"
                        Command="{Binding DownloadCommand}">
                    <TextBlock Text="{Binding DownloadLabel}"
                               FontFamily="{StaticResource Plex}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource FetchTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2"
                    Margin="24,0,24,8"
                    Spacing="8"
                    IsVisible="{Binding ShowProgress}">
            <ProgressBar Height="6"
                         Minimum="0"
                         Maximum="100"
                         IsIndeterminate="{Binding ProgressIsIndeterminate}"
                         Value="{Binding Progress}"
                         Foreground="{DynamicResource InkBrush}" />
            <TextBlock Text="{Binding ProgressText}"
                       FontFamily="{StaticResource Plex}"
                       FontSize="13"
                       FontWeight="Medium"
                       Foreground="{DynamicResource InkBrush}" />
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Margin="24,0,24,12"
                   Text="© 2026 stuckinowhere · MIT"
                   FontFamily="{StaticResource Plex}"
                   FontSize="12"
                   FontWeight="Medium"
                   Foreground="{DynamicResource MutedBrush}"
                   HorizontalAlignment="Left" />
    </Grid>
</Window>
