<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FetchIt.ViewModels"
        xmlns:s="using:FetchIt.Services"
        xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="FetchIt.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/fetchit.png"
        Title="fetch it"
        Width="1100"
        Height="700"
        MinWidth="800"
        MinHeight="520"
        CanResize="True"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        DragDrop.AllowDrop="True"
        Background="{DynamicResource PaperBrush}"
        Foreground="{DynamicResource InkBrush}"
        KeyDown="OnKeyDown">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <Border Grid.Row="0" Height="56" Padding="8,0">
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="0"
                        Margin="0,0,4,0">
                    <Button Classes="Flat"
                            Width="48"
                            Height="48"
                            Padding="0"
                            Command="{Binding ShowAccountCommand}"
                            ToolTip.Tip="{x:Static s:L.AccountTip}"
                            AutomationProperties.Name="{x:Static s:L.AccountTip}">
                        <Panel>
                            <icons:MaterialIcon Kind="AccountCircle"
                                                Width="26"
                                                Height="26"
                                                IsVisible="{Binding IsSignedIn}" />
                            <icons:MaterialIcon Kind="AccountCircleOutline"
                                                Width="26"
                                                Height="26"
                                                IsVisible="{Binding IsSignedIn, Converter={x:Static BoolConverters.Not}}" />
                        </Panel>
                    </Button>
                    <Button Classes="Flat"
                            Width="48"
                            Height="48"
                            Padding="0"
                            Command="{Binding PickFolderCommand}"
                            ToolTip.Tip="{x:Static s:L.SaveFolderTip}">
                        <icons:MaterialIcon Kind="Folder"
                                            Width="26"
                                            Height="26" />
                    </Button>
                    <Button Classes="Flat"
                            Width="48"
                            Height="48"
                            Padding="0"
                            Command="{Binding CheckForUpdatesCommand}"
                            ToolTip.Tip="{x:Static s:L.UpdatesTip}">
                        <icons:MaterialIcon Kind="Update"
                                            Width="26"
                                            Height="26" />
                    </Button>
                    <Button Classes="Flat"
                            Width="48"
                            Height="48"
                            Padding="0"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip.Tip="{x:Static s:L.ThemeTip}">
                        <Panel>
                            <icons:MaterialIcon Kind="WeatherNight"
                                                Width="26"
                                                Height="26"
                                                IsVisible="{Binding IsDark}" />
                            <icons:MaterialIcon Kind="WhiteBalanceSunny"
                                                Width="26"
                                                Height="26"
                                                IsVisible="{Binding IsDark, Converter={x:Static BoolConverters.Not}}" />
                        </Panel>
                    </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1"
              RowDefinitions="Auto,*,Auto"
              Margin="24,12,24,8">
            <Grid ColumnDefinitions="*,Auto">
                <Border BorderBrush="{DynamicResource InkBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Height="56"
                        Padding="14,0"
                        Background="Transparent">
                    <TextBox BorderThickness="0"
                             Background="Transparent"
                             PlaceholderText="https://"
                             Text="{Binding Url}"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding FetchCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                </Border>
                <Button Grid.Column="1"
                        Classes="fetch"
                        Margin="16,0,0,0"
                        Height="56"
                        VerticalAlignment="Stretch"
                        IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}"
                        Command="{Binding FetchCommand}">
                    <TextBlock Text="{Binding FetchLabel}"
                               FontFamily="{StaticResource Plex}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource FetchTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="0,16,0,0"
                  SizeChanged="OnPreviewSizeChanged">
                <TextBlock Text="{x:Static s:L.EmptyHint}"
                           IsVisible="{Binding ShowEmptyHint}"
                           FontFamily="{StaticResource Plex}"
                           FontSize="16"
                           FontWeight="Medium"
                           Foreground="{DynamicResource InkBrush}" />

                <Panel IsVisible="{Binding IsSinglePreview}">
                    <Border Background="#1A1A1A" ClipToBounds="True">
                        <Image Source="{Binding Hero.Image}"
                               Stretch="Uniform"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               IsVisible="{Binding Hero.Image, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </Border>
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="12"
                            Background="#CC000000"
                            CornerRadius="4"
                            Padding="8,3">
                        <TextBlock Text="{Binding Hero.Overlay}"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold" />
                    </Border>
                </Panel>

                <ScrollViewer IsVisible="{Binding HasManyPreviews}"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding PreviewCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PreviewCard">
                                    <controls:Card Width="{Binding TileWidth}"
                                                   Margin="0,0,16,16"
                                                   Padding="0">
                                        <StackPanel>
                                            <Panel Height="{Binding TileImageHeight}"
                                                   ClipToBounds="True">
                                                <Border Background="#1A1A1A" />
                                                <Image Source="{Binding Image}"
                                                       Stretch="UniformToFill"
                                                       IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <Border HorizontalAlignment="Left"
                                                        VerticalAlignment="Bottom"
                                                        Margin="8"
                                                        Background="#CC000000"
                                                        CornerRadius="4"
                                                        Padding="6,2">
                                                    <TextBlock Text="{Binding Overlay}"
                                                               Foreground="White"
                                                               FontSize="12"
                                                               FontWeight="Bold" />
                                                </Border>
                                            </Panel>
                                            <TextBlock Text="{Binding Title}"
                                                       Margin="12,8,12,12"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="40"
                                                       FontSize="14"
                                                       FontWeight="Medium" />
                                        </StackPanel>
                                    </controls:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="2"
                  ColumnDefinitions="*,Auto"
                  Margin="0,12,0,0"
                  IsVisible="{Binding HasPreview}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontFamily="{StaticResource Plex}"
                               FontSize="18"
                               FontWeight="Medium"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="48" />
                    <TextBlock Text="{Binding Summary}"
                               Margin="0,4,0,0"
                               FontFamily="{StaticResource Plex}"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="fetch"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        IsEnabled="{Binding CanDownload}"
                        Command="{Binding DownloadCommand}"
                        ToolTip.Tip="Ctrl+Enter">
                    <TextBlock Text="{Binding DownloadLabel}"
                               FontFamily="{StaticResource Plex}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource FetchTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2"
                    Margin="24,0,24,8"
                    Spacing="8">
            <StackPanel Spacing="8" IsVisible="{Binding ShowProgress}">
                <ProgressBar Height="6"
                             Minimum="0"
                             Maximum="100"
                             IsIndeterminate="{Binding ProgressIsIndeterminate}"
                             Value="{Binding Progress}"
                             Foreground="{DynamicResource InkBrush}" />
                <TextBlock Text="{Binding ProgressText}"
                           FontFamily="{StaticResource Plex}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource InkBrush}" />
            </StackPanel>

            <!-- Inline result: no modal for a success, and a one-click way to the files. -->
            <StackPanel Orientation="Horizontal"
                        Spacing="16"
                        IsVisible="{Binding ShowStatus}">
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource Plex}"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SuccessBrush}"
                           IsVisible="{Binding StatusIsError, Converter={x:Static BoolConverters.Not}}" />
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource Plex}"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DangerBrush}"
                           IsVisible="{Binding StatusIsError}" />
                <Button Classes="Flat"
                        Command="{Binding OpenFolderCommand}"
                        IsVisible="{Binding ShowOpenFolder}"
                        AutomationProperties.Name="{x:Static s:L.OpenFolder}"
                        Cursor="Hand"
                        Padding="12,0"
                        Height="36">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <icons:MaterialIcon Kind="FolderOpen" Width="20" Height="20" />
                        <TextBlock Text="{x:Static s:L.OpenFolder}"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource Plex}"
                                   FontSize="14"
                                   FontWeight="Bold" />
                    </StackPanel>
                </Button>
                <Button Classes="Flat"
                        Command="{Binding SeparateCommand}"
                        IsVisible="{Binding ShowSeparate}"
                        AutomationProperties.Name="{x:Static s:L.SeparateNoPeople}"
                        Cursor="Hand"
                        Padding="12,0"
                        Height="36">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <icons:MaterialIcon Kind="AccountOff" Width="20" Height="20" />
                        <TextBlock Text="{x:Static s:L.SeparateNoPeople}"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource Plex}"
                                   FontSize="14"
                                   FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Margin="24,0,24,12"
                   Text="{x:Static s:L.Footer}"
                   FontFamily="{StaticResource Plex}"
                   FontSize="12"
                   FontWeight="Medium"
                   Foreground="{DynamicResource MutedBrush}"
                   HorizontalAlignment="Left" />
    </Grid>
</Window>
