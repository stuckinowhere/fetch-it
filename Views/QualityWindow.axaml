<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="using:FetchIt.Services"
        x:Class="FetchIt.Views.QualityWindow"
        Icon="/Assets/fetchit.png"
        Title="fetch it"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource PaperBrush}"
        Foreground="{DynamicResource InkBrush}">
    <StackPanel Margin="24" Spacing="16">
        <TextBlock Text="{x:Static s:L.Quality}"
                   FontSize="12"
                   FontWeight="Bold"
                   Foreground="{DynamicResource MutedBrush}" />
        <TextBlock x:Name="Body"
                   FontSize="16"
                   FontWeight="Medium"
                   TextWrapping="Wrap" />
        <StackPanel x:Name="Choices" Spacing="8" />
        <Button Classes="Flat"
                HorizontalAlignment="Right"
                Content="{x:Static s:L.Cancel}"
                IsCancel="True"
                Click="OnCancelClick" />
    </StackPanel>
</Window>
