<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="using:FetchIt.Services"
        x:Class="FetchIt.Views.AccountWindow"
        Icon="/Assets/fetchit.png"
        Title="fetch it"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource PaperBrush}"
        Foreground="{DynamicResource InkBrush}">
    <StackPanel Margin="24" Spacing="16">
        <TextBlock Text="{x:Static s:L.Accounts}"
                   FontSize="12"
                   FontWeight="Bold"
                   Foreground="{DynamicResource SuccessBrush}" />
        <StackPanel Spacing="4">
            <TextBlock Text="Instagram"
                       FontSize="16"
                       FontWeight="Bold" />
            <TextBlock x:Name="Status"
                       FontSize="14"
                       FontWeight="Medium"
                       TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Text="{x:Static s:L.AccountNote}"
                   FontSize="13"
                   FontWeight="Medium"
                   Foreground="{DynamicResource MutedBrush}"
                   TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1"
                    Classes="Flat"
                    Margin="0,0,8,0"
                    Content="{x:Static s:L.Close}"
                    IsCancel="True"
                    Click="OnCloseClick" />
            <Button x:Name="Primary"
                    Grid.Column="2"
                    Classes="fetch"
                    Height="48"
                    MinWidth="160"
                    IsDefault="True"
                    Click="OnPrimaryClick">
                <TextBlock x:Name="PrimaryLabel"
                           FontFamily="{StaticResource Plex}"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource FetchTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Button>
        </Grid>
    </StackPanel>
</Window>
